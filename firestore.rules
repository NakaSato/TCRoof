rules_version = '2';

// TCRoof team data. Only team members can read or write, and only the collections the app syncs.
// A member is a Google account with a document at members/<email, lowercase> — add or remove people
// in the Firebase console (Firestore → members), or as a manager in the app's สมาชิก screen.
//
// Roles (docs/reference/roles/user-roles.json): members/<email>.role is "manager", "internal" or "external";
// none is the internal team. "maintainer" (the app's developer) can do everything a manager can, and alone suspends
// accounts, reads the developer key and edits the role overrides; it is set in the Firebase console only. A suspended
// member (`suspended: true`) is no member at all until a Maintainer reactivates them. An external engineer or contractor reads only the documents that list their email in
// `externals` (a job's assigned people, copied onto its records by the app) and writes only what their role lets
// them: a job's IEC test, its daily reports (unsigned), device scans, photos and surveys. The customers' phones and
// addresses are in jobContacts, which they never read.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email.lower();
    }
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(signedInEmail()))
        && get(/databases/$(database)/documents/members/$(signedInEmail())).data.get('suspended', false) != true;
    }
    function role() {
      return get(/databases/$(database)/documents/members/$(signedInEmail())).data.get('role', 'internal');
    }
    function isTeam() {
      return isMember() && role() != 'external';
    }
    // A Maintainer is a manager too.
    function isManager() {
      return isMember() && role() in ['manager', 'maintainer'];
    }
    function isMaintainer() {
      return isMember() && role() == 'maintainer';
    }
    function isExternal() {
      return isMember() && role() == 'external';
    }
    // A read of a document that lists the signed-in external member, written plainly so Firestore can check the
    // app's query (`externals` array-contains their email) against it.
    function readsMine() {
      return isExternal() && signedInEmail() in resource.data.externals;
    }
    // The document lists the signed-in external member.
    function listsMe(data) {
      return data.get('externals', []) is list && signedInEmail() in data.get('externals', []);
    }
    // An external member's write keeps the document theirs and doesn't change who it is open to.
    function keepsMe() {
      return listsMe(request.resource.data)
        && (resource == null || (listsMe(resource.data)
            && request.resource.data.get('externals', []) == resource.data.get('externals', [])));
    }
    // The job a record points at is assigned to the signed-in external member.
    function jobIsMine(jobID) {
      return jobID is string
        && listsMe(get(/databases/$(database)/documents/jobs/$(jobID)).data);
    }
    // The daily report a photo points at lists the signed-in external member.
    function logIsMine(logID) {
      return logID is string
        && listsMe(get(/databases/$(database)/documents/installLogs/$(logID)).data);
    }
    // The signed-in team member signs the daily reports of this job: on its team, its supervisor, or the job names
    // none of ours (Permissions.signsDaily).
    function signsFor(jobID) {
      let job = get(/databases/$(database)/documents/jobs/$(jobID)).data;
      let team = job.get('teamMembers', []);
      let supervisor = job.get('supervisor', '');
      return jobID is string
        && ((team.size() == 0 && (supervisor == '' || supervisor == null))
            || signedInEmail() in team || supervisor == signedInEmail());
    }
    // The fields an update changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // A daily report's engineer signature and inspector acknowledgement are as they were, or cleared.
    function signaturesKeptOrCleared() {
      return (unchanged('engineerSignedAt') || request.resource.data.get('engineerSignedAt', null) == null)
        && (unchanged('inspectorAckAt') || request.resource.data.get('inspectorAckAt', null) == null);
    }
    function unchanged(field) {
      return request.resource.data.get(field, null) == (resource == null ? null : resource.data.get(field, null));
    }

    // Each person may check their own membership and role (the app reads it after sign-in, suspended or not). A
    // manager lists the members, invites people, changes their role and removes them, never their own document, so no
    // manager can lock themselves out or leave the team without one by mistake. A Maintainer's document is the
    // console's only: no one makes, changes or removes one from the app. Only a Maintainer suspends or reactivates an
    // account (`suspended`, `suspendedBy`, `suspendedAt`), never their own; a manager can't remove a suspended one
    // either, which would let it be invited back.
    match /members/{email} {
      function target() {
        return resource.data.get('role', 'internal');
      }
      function suspension() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedBy', 'suspendedAt'])
          && ((request.resource.data.get('suspended', null) == true
               && request.resource.data.get('suspendedBy', null) == signedInEmail()
               && request.resource.data.get('suspendedAt', null) == request.time)
            || !request.resource.data.keys().hasAny(['suspended', 'suspendedBy', 'suspendedAt']));
      }
      allow read: if request.auth != null && (signedInEmail() == email || isManager());
      allow create: if isManager() && email != signedInEmail() && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'invitedBy', 'invitedAt'])
        && request.resource.data.get('role', 'internal') in ['manager', 'internal', 'external']
        && request.resource.data.invitedBy == signedInEmail();
      allow update: if isManager() && email != signedInEmail() && target() != 'maintainer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['manager', 'internal', 'external'];
      allow update: if isMaintainer() && email != signedInEmail() && target() != 'maintainer' && suspension();
      allow delete: if isManager() && email != signedInEmail() && target() != 'maintainer'
        && (resource.data.get('suspended', false) != true || isMaintainer());
    }

    // Who changed members, roles and permissions (จัดการผู้ใช้และสิทธิ์): written once by a manager or Maintainer as
    // themselves, read by a Maintainer, never changed or removed.
    match /auditLog/{id} {
      allow read: if isMaintainer();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['at', 'by', 'kind', 'title', 'detail'])
        && request.resource.data.by == signedInEmail()
        && request.resource.data.at == request.time
        && request.resource.data.kind in ['role', 'perm', 'user', 'key', 'sus']
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 500;
      allow update, delete: if false;
    }

    // The team's names and emails (TeamDirectory), to pick a job's team members from: the team reads it, an external
    // member never does. Only a team member or manager is listed; each writes their own entry, a manager anyone's;
    // a manager removes one. No roles in it, only `email` (the id) and a `name`.
    match /directory/{email} {
      allow read: if isTeam();
      allow create, update: if isTeam() && (email == signedInEmail() || isManager())
        && request.resource.data.keys().hasOnly(['email', 'name'])
        && request.resource.data.email == email
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 100
        && exists(/databases/$(database)/documents/members/$(email))
        && get(/databases/$(database)/documents/members/$(email)).data.get('role', 'internal') != 'external';
      allow delete: if isManager();
    }

    // Switches set in the Firebase console (contactsSplit).
    match /config/{doc} {
      allow read: if isMember() && !(doc in ['devKey']);
      allow write: if false;
    }
    // The developer key that opens จัดการผู้ใช้และสิทธิ์: a PBKDF2 hash and its salt, never the digits. A Maintainer's
    // only, to read or to set. The key only gates the page: these rules decide what its changes may do.
    match /config/devKey {
      allow read: if isMaintainer();
      allow write: if isMaintainer()
        && request.resource.data.keys().hasOnly(['hash', 'salt', 'iterations', 'expiresAt', 'setBy', 'setAt'])
        && request.resource.data.hash is string && request.resource.data.salt is string
        && request.resource.data.iterations is int && request.resource.data.iterations >= 10000
        && request.resource.data.setBy == signedInEmail();
    }
    // Overrides of the role table (`{ "<role>|<capability>": "<access>" }`, `Permissions`): every member reads them, a
    // Maintainer writes them. They change what the app shows, never what these rules allow.
    match /config/roleOverrides {
      allow read: if isMember();
      allow write: if isMaintainer();
    }

    // Jobs: the team reads and writes them; an external member reads their jobs and changes only the IEC test, while
    // it is open (`iecState`, written by the app beside the test). They may send it (`sent`), never close it: once
    // sent or closed, only the team sends it back or reopens it. Team devices drop a close the state doesn't record.
    match /jobs/{doc} {
      allow read: if isTeam() || readsMine();
      allow create: if isTeam();
      // ลบงาน (job.delete) is the manager's only
      allow delete: if isManager();
      // A contractor changes only the IEC test (while it is open, and never closes it) and the weekly requests R1
      // (weekly.request), signing the latter with their own email in `weeklyRequestsBy`: a rule can't read inside the
      // JSON, so team devices drop a contractor's change to a week already sent or approved
      // (RoutineReport.WeeklyRequest.trusting).
      allow update: if isTeam()
        || (isExternal() && listsMe(resource.data)
            && changedKeys().hasOnly(['iecReport', 'iecState', 'weeklyRequests', 'weeklyRequestsBy'])
            && (!changedKeys().hasAny(['iecReport', 'iecState'])
                || (resource.data.get('iecState', 'open') == 'open'
                    && request.resource.data.get('iecState', null) in ['open', 'sent']))
            && (!changedKeys().hasAny(['weeklyRequests', 'weeklyRequestsBy'])
                || request.resource.data.get('weeklyRequestsBy', null) == signedInEmail()));
    }

    // The customers' phones and addresses, one document per job: the team's only.
    match /jobContacts/{doc} {
      allow read, write: if isTeam();
    }

    // Daily reports: the contractor's foreman fills them; only our engineer signs or records the inspector, and on a job
    // that names its people (teamMembers, supervisor) only they or a manager do (daily.sign). Anyone of the team may keep
    // a signature or clear it, as editing a signed report does.
    match /installLogs/{doc} {
      allow read: if isTeam() || readsMine();
      allow create, update: if isTeam() && (isManager() || signaturesKeptOrCleared()
        || signsFor(request.resource.data.get('jobID', null)));
      allow delete: if isTeam();
      // a contractor changes a report only while it is unsigned: the MP plan counts signed reports, so a signed one
      // stays as our engineer signed it (the team may still edit it, keeping or clearing the signature)
      allow create, update: if isExternal() && keepsMe() && jobIsMine(request.resource.data.jobID)
        && unchanged('engineerSignedAt') && unchanged('inspectorAckAt')
        && (resource == null || resource.data.get('engineerSignedAt', null) == null);
    }

    // Device scans and survey forms of their jobs; photos of their records.
    match /devices/{doc} {
      allow read: if isTeam() || readsMine();
      allow write: if isTeam();
      allow create, update: if isExternal() && keepsMe() && jobIsMine(request.resource.data.jobID);
      allow delete: if isExternal() && listsMe(resource.data);
    }
    match /surveyForms/{doc} {
      allow read: if isTeam() || readsMine();
      allow write: if isTeam();
      allow create, update: if isExternal() && keepsMe() && jobIsMine(request.resource.data.jobID);
    }
    match /photos/{doc} {
      allow read: if isTeam() || readsMine();
      allow write: if isTeam();
      // The record it points at must be theirs too: a daily report of their job, or their job's IEC test. Never an
      // ICL, which they only read. Otherwise team devices would attach it to someone else's record.
      allow create, update: if isExternal() && keepsMe()
        && request.resource.data.get('inspection', null) == null
        && (request.resource.data.get('log', null) == null || logIsMine(request.resource.data.log))
        && (request.resource.data.get('iecJob', null) == null || jobIsMine(request.resource.data.iecJob));
      allow delete: if isExternal() && listsMe(resource.data);
    }

    // ICL check lists: an external member only reads theirs.
    match /inspections/{doc} {
      allow read: if isTeam() || readsMine();
      allow write: if isTeam();
    }

    // NO.224 survey reports: an external engineer edits the surveys of the jobs assigned to them.
    match /pwaSurveys/{doc} {
      allow read: if isTeam() || readsMine();
      allow write: if isTeam();
      allow update: if isExternal() && keepsMe();
    }

    // An issued REV of a survey report is written once: it may be created, sent again unchanged, or deleted
    // with its job, never changed. The team's only. Its id is `<survey id>_<rev>`; a team member deletes it once the
    // survey is gone (the app retries the delete at its next push), a manager at any time.
    match /pwaSurveyRevisions/{doc} {
      allow read, create: if isTeam();
      allow delete: if isManager()
        || (isTeam() && !exists(/databases/$(database)/documents/pwaSurveys/$(doc.split('_')[0])));
      allow update: if isTeam() && request.resource.data.json == resource.data.json;
    }

    // The standard design library (docs/specs/standard-designs.md §2, `design.library`): every member reads the
    // designs, only the team saves them, and an edit never goes back to an older revision. Never deleted (archived).
    match /standardDesigns/{doc} {
      allow read: if isMember();
      allow create: if isTeam() && request.resource.data.revision is int;
      allow update: if isTeam() && request.resource.data.revision is int
        && request.resource.data.revision >= resource.data.revision;
    }
    // A design's scanned sheet, one JPEG page per document (base64 `data`, the design's id in `design`).
    match /standardDesignSheets/{page} {
      allow read: if isMember();
      allow create, update: if isTeam() && request.resource.data.design is string && request.resource.data.data is string;
    }

    // The travel and expense log (docs/specs/calendar-travel-expenses-swift.md §B6): trips, expenses and monthly claims
    // are personal. A team member reads and writes only their own (`ownerEmail` is their signed-in email, and can't be
    // handed to someone else); a manager may read everyone's, to approve claims. External members have none.
    function ownsTravel() {
      return isTeam() && resource.data.ownerEmail == signedInEmail();
    }
    function keepsOwner() {
      return isTeam() && request.resource.data.ownerEmail == signedInEmail()
        && (resource == null || resource.data.ownerEmail == signedInEmail());
    }
    match /trips/{doc} {
      allow read: if ownsTravel() || isManager();
      allow create, update: if keepsOwner();
      allow delete: if ownsTravel();
    }
    match /expenses/{doc} {
      allow read: if ownsTravel() || isManager();
      allow create, update: if keepsOwner() && request.resource.data.amount is int;
      allow delete: if ownsTravel();
    }
    match /claims/{doc} {
      allow read: if ownsTravel() || isManager();
      allow create, update: if keepsOwner();
      allow delete: if ownsTravel();
    }

    // The home feed's acknowledgements (รับทราบ): one document per post, its members the emails that acknowledged it.
    // A member adds or removes only their own email.
    match /feedAcks/{doc} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['post', 'members'])
        && request.resource.data.post is string
        && request.resource.data.members is list
        && request.resource.data.members.toSet()
             .difference(resource == null ? [].toSet() : resource.data.members.toSet())
             .union((resource == null ? [].toSet() : resource.data.members.toSet())
             .difference(request.resource.data.members.toSet()))
             .hasOnly([signedInEmail(), request.auth.token.email]);
    }
  }
}
