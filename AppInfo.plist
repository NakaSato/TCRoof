<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- merged with the generated Info.plist; the value is set in Secrets.xcconfig (git-ignored) -->
	<key>GISTDAAPIKey</key>
	<string>$(GISTDA_API_KEY)</string>
	<key>MapboxAccessToken</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<!-- tcroof://job/<syncID> opens the job, e.g. from a survey appointment in Calendar -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tcroof.internal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tcroof</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
