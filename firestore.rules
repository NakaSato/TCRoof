rules_version = '2';

// TCRoof team data. Only team members can read or write, and only the collections the app syncs.
// A member is a Google account with a document at members/<email, lowercase> — add or remove people
// in the Firebase console (Firestore → members). The app can't edit this list.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email.lower();
    }
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(signedInEmail()));
    }

    // Each person may check their own membership (the app uses this to explain a refusal).
    match /members/{email} {
      allow read: if request.auth != null && signedInEmail() == email;
      allow write: if false;
    }

    match /{collection}/{doc} {
      allow read, write: if isMember()
        && collection in ['jobs', 'surveyForms', 'devices', 'installLogs', 'inspections', 'pwaSurveys'];
    }
  }
}
